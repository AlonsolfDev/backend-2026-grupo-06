# Colección de pruebas manuales — Salas

@host = http://localhost:8000

# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "correo": "admin@uct.cl",
  "password": "Demo.2026.Segura!"
}

@token = {{login.response.body.$.access_token}}

### 1. Crear sala (201)
# @name crearSala
POST {{host}}/salas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Laboratorio 3",
  "capacidad": 8,
  "ubicacion": "Edificio C, piso 1"
}

### 2. Listar con filtro, orden y paginación (200)
GET {{host}}/salas?estado=disponible&ordenar_por=capacidad&direccion=desc&pagina=1&limite=5

### 3. Sala con su equipamiento (200)
GET {{host}}/salas/1

### 4. Equipamiento de una sala (200)
GET {{host}}/salas/1/equipamientos

### 5. Disponibilidad libre (200, disponible=true)
GET {{host}}/salas/2/disponibilidad?fecha_inicio=2026-12-20T08:00:00&fecha_fin=2026-12-20T10:00:00

### 6. Disponibilidad ocupada (200, disponible=false)
GET {{host}}/salas/1/disponibilidad?fecha_inicio=2026-12-02T09:30:00&fecha_fin=2026-12-02T10:30:00

### 7. Actualizar sala (200)
PUT {{host}}/salas/{{crearSala.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Laboratorio 3 actualizado",
  "capacidad": 10,
  "ubicacion": "Edificio C, piso 2"
}

### 8. Poner la sala en mantenimiento (200)
PATCH {{host}}/salas/{{crearSala.response.body.$.id}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "mantenimiento"
}

### 9. Reservar una sala en mantenimiento (409 CONFLICT)
POST {{host}}/reservas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": 3,
  "sala_id": {{crearSala.response.body.$.id}},
  "fecha_inicio": "2026-12-21T10:00:00",
  "fecha_fin": "2026-12-21T12:00:00",
  "proposito": "Prueba de mantenimiento",
  "num_asistentes": 5
}

### 10. Sala inexistente (404 RESOURCE_NOT_FOUND)
GET {{host}}/salas/9999

### 11. Validación de capacidad (422 VALIDATION_ERROR)
POST {{host}}/salas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Sala inválida",
  "capacidad": 0,
  "ubicacion": "Sin ubicación"
}

### 12. Eliminar una sala con reservas (409 CONFLICT)
DELETE {{host}}/salas/1
Authorization: Bearer {{token}}

### 13. Eliminar la sala creada (204)
DELETE {{host}}/salas/{{crearSala.response.body.$.id}}
Authorization: Bearer {{token}}
