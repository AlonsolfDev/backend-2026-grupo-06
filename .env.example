# --- Base de datos -------------------------------------------------------
# Local con SQLite (por defecto si no se define):
DATABASE_URL=sqlite:///./reservas.db
# Docker con PostgreSQL (lo define compose.yaml):
# DATABASE_URL=postgresql+psycopg://reservas:reservas@db:5432/reservas

# --- Seguridad -----------------------------------------------------------
# Genera una clave propia con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-bytes
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
RECUPERACION_MINUTOS=15
# Segundos mínimos entre solicitudes de recuperación de una misma cuenta.
RECUPERACION_COOLDOWN_SEGUNDOS=120

PASSWORD_MIN_LARGO=12
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# --- CORS ---------------------------------------------------------------
# Orígenes explícitos separados por coma. No usar "*" con credenciales.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Entorno -------------------------------------------------------------
# dev | test | produccion
ENTORNO=dev
# En producción debe ser false: el enlace viaja solo por correo.
EXPONER_ENLACE_RECUPERACION=true
BASE_URL=http://localhost:8000

# --- Correo (Mailpit en Docker) -----------------------------------------
# Vacío = no se intenta enviar correo.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=no-reply@reservas.uct.cl
